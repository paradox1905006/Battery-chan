<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 app theme. Dynamic color (Android 12+) is layered on top at runtime by
         BaseActivity when enabled; this static scheme is the fallback. -->
    <style name="Theme.BatteryChan" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_light_primary</item>
        <item name="colorOnPrimary">@color/m3_light_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_light_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_light_on_primary_container</item>
        <item name="colorSecondary">@color/m3_light_secondary</item>
        <item name="colorOnSecondary">@color/m3_light_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_light_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_light_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_light_tertiary</item>
        <item name="colorOnTertiary">@color/m3_light_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_light_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_light_on_tertiary_container</item>
        <item name="colorError">@color/m3_light_error</item>
        <item name="colorOnError">@color/m3_light_on_error</item>
        <item name="colorErrorContainer">@color/m3_light_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_light_on_error_container</item>
        <item name="colorSurface">@color/m3_light_surface</item>
        <item name="colorOnSurface">@color/m3_light_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_light_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_light_on_surface_variant</item>
        <item name="colorOutline">@color/m3_light_outline</item>
        <item name="colorOutlineVariant">@color/m3_light_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_light_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_light_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_light_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_light_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_light_surface_container_highest</item>
        <item name="android:colorBackground">@color/m3_light_surface</item>
        <item name="colorOnBackground">@color/m3_light_on_surface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Full-screen event pop-up. -->
    <style name="Theme.BatteryChan.PopUp" parent="Theme.BatteryChan">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
    </style>
</resources>
