<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Material3.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="Settings"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <!-- Appearance -->
            <TextView
                style="@style/Widget.BatteryChan.SectionHeader"
                android:text="Appearance" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Theme"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/btn_theme_system"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:paddingHorizontal="4dp"
                            android:text="System" />

                        <Button
                            android:id="@+id/btn_theme_light"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingHorizontal="4dp"
                            android:text="Light" />

                        <Button
                            android:id="@+id/btn_theme_dark"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingHorizontal="4dp"
                            android:text="Dark" />

                        <Button
                            android:id="@+id/btn_theme_black"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingHorizontal="4dp"
                            android:text="Black" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_dynamic_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Dynamic color (Material You)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- General -->
            <TextView
                style="@style/Widget.BatteryChan.SectionHeader"
                android:text="Alerts" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_global_events"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Enable battery events" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_auto_dismiss_audio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Auto-dismiss after audio ends" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_boost_volume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="Play event sounds at max volume" />

                    <TextView
                        android:id="@+id/tv_duration_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Pop-up duration: 10 s"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_duration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:value="10"
                        android:valueFrom="5"
                        android:valueTo="30" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Permissions -->
            <TextView
                style="@style/Widget.BatteryChan.SectionHeader"
                android:text="Permissions" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:id="@+id/ll_permissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Mini player -->
            <TextView
                style="@style/Widget.BatteryChan.SectionHeader"
                android:text="Mini player" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A small image, GIF or video that loops forever on your home screen. Video sound is always muted."
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_mini_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Show mini player" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mini_pick"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Add image / GIF / video"
                        app:icon="@drawable/ic_image" />

                    <LinearLayout
                        android:id="@+id/ll_mini_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tv_mini_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="2dp"
                        android:text="Nothing added yet"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:id="@+id/ll_mini_playlist_opts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggle_mini_order"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <Button
                                android:id="@+id/btn_mini_order_seq"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="In order" />

                            <Button
                                android:id="@+id/btn_mini_order_shuffle"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Shuffle" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_mini_switch"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Change every: never" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_mini_lock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Lock position and size (home screen)" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Unlocked: drag to move, drag the white corner dot to resize width and height, or pinch to scale. Locked: it stays exactly where it is and touches go through to your home screen."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_mini_home_only"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:checked="true"
                        android:text="Show only on the home screen" />

                    <TextView
                        android:id="@+id/tv_mini_usage_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mini_usage"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Grant usage access"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_mini_hide_drawer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Hide in the app drawer" />

                    <TextView
                        android:id="@+id/tv_mini_drawer_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mini_accessibility"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Open accessibility settings"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_mini_drawer_marker"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Text that only shows in your app drawer"
                        app:helperText="For example the search box text. Optional, helps detection."
                        app:helperTextEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_mini_drawer_marker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_mini_lock_lockscreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Lock position and size (lock screen)"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_mini_show_lock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Also show on the lock screen" />

                    <TextView
                        android:id="@+id/tv_mini_lock_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Picture fit"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_mini_scale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/btn_mini_scale_fill"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingHorizontal="4dp"
                            android:text="Fill" />

                        <Button
                            android:id="@+id/btn_mini_scale_stretch"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingHorizontal="4dp"
                            android:text="Stretch" />

                        <Button
                            android:id="@+id/btn_mini_scale_fit"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingHorizontal="4dp"
                            android:text="Fit" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Fill crops the edges, Stretch squeezes the picture to the box, Fit shows all of it."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Opacity"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_mini_opacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="Mini player opacity"
                        android:stepSize="1"
                        android:value="100"
                        android:valueFrom="20"
                        android:valueTo="100" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="On Android 12 and newer, while it is locked it is limited to 80% so taps can still reach your home screen."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Corner roundness"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_mini_corner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="Mini player corner roundness"
                        android:stepSize="1"
                        android:value="18"
                        android:valueFrom="0"
                        android:valueTo="100" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_mini_pause_saver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="Pause in battery saver" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Freezes the picture while Android's battery saver is on, to save power."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_mini_snap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Snap to screen edges" />

                    <TextView
                        android:id="@+id/tv_mini_pause_below"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Pause when battery is below: off"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_mini_pause_below"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="Pause below battery percent"
                        android:stepSize="5"
                        android:value="0"
                        android:valueFrom="0"
                        android:valueTo="50" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mini_reset"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Reset position and size" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Network speed meter -->
            <TextView
                style="@style/Widget.BatteryChan.SectionHeader"
                android:text="Network speed meter" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Live download and upload speed of the whole phone (Wi-Fi and mobile data)."
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_speed_under"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Show inside the mini player" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_speed_notif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Show in the status bar and notification panel" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Inside the player the speed is bold text you can drag to any spot while 'Lock position and size' is off. The notification works on its own, even without the mini player. The speed pauses while the screen is off."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Speed unit"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_speed_unit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/btn_unit_bytes"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="MB/s" />

                        <Button
                            android:id="@+id/btn_unit_bits"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mbps" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_speed_auto_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Match the video's colour (auto)" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Speed colour (used when auto is off)"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/ll_speed_colors"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Custom colour (hex, e.g. FF4081)"
                        app:prefixText="#">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_speed_hex"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLength="7" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Speed text size"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_speed_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="Speed meter text size"
                        android:stepSize="1"
                        android:value="12"
                        android:valueFrom="8"
                        android:valueTo="40" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_speed_reset_pos"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset speed position" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Backup -->
            <TextView
                style="@style/Widget.BatteryChan.SectionHeader"
                android:text="Backup" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save every setting, event, picture, video and sound into one file, and bring it back after a reset or on a new phone."
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_backup_export"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Export backup" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_backup_import"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Import backup" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Events -->
            <TextView
                style="@style/Widget.BatteryChan.SectionHeader"
                android:text="Events" />

            <LinearLayout
                android:id="@+id/container_events"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_event"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Add custom event"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart" />

            <!-- Power indicator -->
            <TextView
                style="@style/Widget.BatteryChan.SectionHeader"
                android:text="Power indicator" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Shows a live battery reading in the status bar."
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_power_indicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Show live power indicator" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Indicator units"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_units"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_unit_v"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="V" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_unit_wh"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wh" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_unit_ah"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ah" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_unit_c"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="°C" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_unit_percent"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="%" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="Battery Chan 1.1.0\nMade by Paradox\nDetailed stats &amp; power indicator ported from Wattz"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
